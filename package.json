{
  "name": "qatestlab-orangehrm-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript E2E tests for the QATestLab OrangeHRM assignment",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug=inspector",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dotenv": "18.0.9",
    "typescript": "5.9.3"
  }
}
